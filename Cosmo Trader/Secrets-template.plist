<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Secrets-template.plist
  Cosmo Trader

  IMPORTANT: This is a TEMPLATE file. Do NOT add real API keys here.

  Setup Instructions:
  1. Copy this file to Secrets.plist
  2. Replace the placeholder values with your actual API keys
  3. Ensure Secrets.plist is in .gitignore (it should be already)

  Getting API Keys:
  - Finnhub: https://finnhub.io (free tier available)
  - Mixpanel: https://mixpanel.com (free tier available)

  Alternative Setup (Recommended):
  Instead of using Secrets.plist, you can use xcconfig files:
  1. Copy Configuration/Secrets.xcconfig.sample to Secrets.xcconfig
  2. Add your API keys there
  3. This allows different keys per environment (dev/staging/prod)
-->
<plist version="1.0">
<dict>
	<key>FINNHUB_API_KEY</key>
	<string>YOUR_FINNHUB_API_KEY_HERE</string>
	<key>MIXPANEL_TOKEN</key>
	<string>YOUR_MIXPANEL_TOKEN_HERE</string>
</dict>
</plist>
