// Staging.xcconfig
// Cosmo Trader
//
// Configuration for staging/QA builds.
// Used with "Cosmo Trader Staging" scheme.

// Include base configuration
#include "Base.xcconfig"

// Include secrets (gitignored)
#include? "Secrets.xcconfig"

// MARK: - Environment
APP_ENVIRONMENT = staging

// MARK: - App Identity (suffix for staging builds)
PRODUCT_BUNDLE_IDENTIFIER = $(COSMO_RELEASE_BUNDLE_IDENTIFIER)
PRODUCT_NAME = Cosmo Trader STG

// MARK: - Build Settings
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
SWIFT_OPTIMIZATION_LEVEL = -O
GCC_OPTIMIZATION_LEVEL = s
ENABLE_TESTABILITY = NO
SWIFT_ACTIVE_COMPILATION_CONDITIONS = STAGING

// MARK: - Staging Features
ENABLE_DEBUG_UI = YES
ENABLE_MOCK_DATA = NO
VERBOSE_LOGGING = YES

// MARK: - API Keys (placeholders - actual values from Secrets.xcconfig)
// These are overridden by Secrets.xcconfig if it exists
// Use staging-specific keys if available:
// FINNHUB_API_KEY_STAGING = (from Secrets.xcconfig)
