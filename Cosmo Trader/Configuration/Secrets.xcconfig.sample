// Secrets.xcconfig.sample
// Cosmo Trader
//
// IMPORTANT: This is a SAMPLE file.
// Copy this to Secrets.xcconfig and fill in your actual API keys.
// Secrets.xcconfig should NEVER be committed to git.
//
// Setup Instructions:
// 1. Copy this file: cp Secrets.xcconfig.sample Secrets.xcconfig
// 2. Fill in your API keys below
// 3. Ensure Secrets.xcconfig is in .gitignore
//
// Getting API Keys:
// - Finnhub: https://finnhub.io (free tier available)

// MARK: - Development API Keys
FINNHUB_API_KEY = YOUR_FINNHUB_API_KEY_HERE
BACKEND_BASE_URL = https://your-cloud-run-service.run.app/

// MARK: - Staging API Keys (optional)
// If you have separate staging keys, define them here
// FINNHUB_API_KEY_STAGING = YOUR_STAGING_FINNHUB_KEY

// MARK: - Production API Keys (optional)
// For extra security, you can use different production keys
// FINNHUB_API_KEY_PRODUCTION = YOUR_PRODUCTION_FINNHUB_KEY

// MARK: - Firebase (if using separate projects per environment)
// FIREBASE_PROJECT_ID_DEV = your-dev-project
// FIREBASE_PROJECT_ID_STAGING = your-staging-project
// FIREBASE_PROJECT_ID_PRODUCTION = your-production-project
